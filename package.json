{
  "name": "local-diff-review",
  "displayName": "Local Diff Review",
  "description": "Review any Git baseline against your working tree with native diffs, inline comments and LLM-ready exports.",
  "version": "0.1.18",
  "publisher": "DynamicLoader",
  "repository": {
    "type": "git",
    "url": "https://github.com/DynamicLoader/DiffReiew.git"
  },
  "license": "BSD-3-Clause",
  "icon": "media/review.png",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:localdiffreview.files"
  ],
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc --noEmit -p .",
    "test": "npm run compile && node --test test/core.test.cjs test/extension.test.cjs test/filesView.test.cjs",
    "test:integration": "npm run compile && node scripts/integration.cjs",
    "package": "npm run compile && node -e \"require('node:fs').mkdirSync('deliverables', { recursive: true })\" && vsce package --out deliverables"
  },
  "contributes": {
    "commands": [
      {
        "command": "localdiffreview.start",
        "title": "Start Review / Select Baseline",
        "category": "Local Diff Review",
        "icon": "$(git-compare)"
      },
      {
        "command": "localdiffreview.resume",
        "title": "Resume Review",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.refresh",
        "title": "Refresh Changes",
        "category": "Local Diff Review",
        "icon": "$(refresh)"
      },
      {
        "command": "localdiffreview.openDiff",
        "title": "Open Diff",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.addComment",
        "title": "Add Review Comment",
        "category": "Local Diff Review",
        "icon": "$(comment-add)"
      },
      {
        "command": "localdiffreview.reply",
        "title": "Save Comment",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.editComment",
        "title": "Edit Comment",
        "category": "Local Diff Review",
        "icon": "$(edit)"
      },
      {
        "command": "localdiffreview.discard",
        "title": "Discard",
        "category": "Local Diff Review",
        "icon": "$(trash)"
      },
      {
        "command": "localdiffreview.discardDraft",
        "title": "Discard",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.toggleResolved",
        "title": "Resolve / Reopen",
        "category": "Local Diff Review",
        "icon": "$(check)"
      },
      {
        "command": "localdiffreview.reanchor",
        "title": "Attach Comment to Current Selection",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.copy",
        "title": "Copy Review for LLM",
        "category": "Local Diff Review",
        "icon": "$(copy)"
      },
      {
        "command": "localdiffreview.export",
        "title": "Export Review (Markdown / JSON)",
        "category": "Local Diff Review",
        "icon": "$(export)"
      },
      {
        "command": "localdiffreview.saveEdit",
        "title": "Save Comment",
        "category": "Local Diff Review"
      },
      {
        "command": "localdiffreview.cancelEdit",
        "title": "Discard Changes",
        "category": "Local Diff Review"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localdiffreview",
          "title": "Local Diff Review",
          "icon": "media/review.svg"
        }
      ]
    },
    "views": {
      "localdiffreview": [
        {
          "id": "localdiffreview.files",
          "type": "tree",
          "name": "Changes & Comments"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "localdiffreview.files",
        "contents": "Compare a Git baseline with the current workspace.\n[Start Review](command:localdiffreview.start)\n[Resume Review](command:localdiffreview.resume)",
        "when": "!localdiffreview.active"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "localdiffreview.start",
          "when": "view == localdiffreview.files",
          "group": "navigation@1"
        },
        {
          "command": "localdiffreview.refresh",
          "when": "view == localdiffreview.files && localdiffreview.active",
          "group": "navigation@2"
        },
        {
          "command": "localdiffreview.copy",
          "when": "view == localdiffreview.files && localdiffreview.active",
          "group": "navigation@3"
        },
        {
          "command": "localdiffreview.export",
          "when": "view == localdiffreview.files && localdiffreview.active",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "localdiffreview.addComment",
          "when": "localdiffreview.active && (resourceScheme == file || resourceScheme == vscode-remote || resourceScheme == localdiffreview-base)",
          "group": "localdiffreview@1"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localdiffreview.reply",
          "when": "commentController == localdiffreview && commentThread != saved && commentThread != editing",
          "group": "inline@1"
        },
        {
          "command": "localdiffreview.discardDraft",
          "when": "commentController == localdiffreview && commentThread != saved && commentThread != editing",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "localdiffreview.toggleResolved",
          "when": "commentController == localdiffreview && commentThread == saved",
          "group": "navigation@1"
        },
        {
          "command": "localdiffreview.editComment",
          "when": "commentController == localdiffreview && commentThread == saved",
          "group": "navigation@2"
        },
        {
          "command": "localdiffreview.discard",
          "when": "commentController == localdiffreview && commentThread == saved",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "localdiffreview.toggleResolved",
          "when": "view == localdiffreview.files && viewItem == reviewComment",
          "group": "inline@1"
        },
        {
          "command": "localdiffreview.editComment",
          "when": "view == localdiffreview.files && viewItem == reviewComment",
          "group": "inline@2"
        },
        {
          "command": "localdiffreview.discard",
          "when": "view == localdiffreview.files && viewItem == reviewComment",
          "group": "inline@3"
        },
        {
          "command": "localdiffreview.reanchor",
          "when": "view == localdiffreview.files && viewItem == reviewComment",
          "group": "review@1"
        }
      ],
      "comments/comment/context": [
        {
          "command": "localdiffreview.saveEdit",
          "when": "commentController == localdiffreview && comment == editing",
          "group": "inline@1"
        },
        {
          "command": "localdiffreview.cancelEdit",
          "when": "commentController == localdiffreview && comment == editing",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "Local Diff Review",
      "properties": {
        "localdiffreview.contextLines": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 20,
          "description": "Context lines included around each reviewed range."
        },
        "localdiffreview.includeResolvedInExport": {
          "type": "boolean",
          "default": false,
          "description": "Include resolved comments in Markdown exports."
        },
        "localdiffreview.gitPath": {
          "type": "string",
          "default": "git",
          "description": "Git executable path."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.7.0"
  }
}
